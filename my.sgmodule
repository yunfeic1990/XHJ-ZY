#!name=cn直連
#!desc=国内直连域名清单 + 直连 DNS；已把会被直连规则盖掉的广告拦截规则排在前面

[General]
direct-dns-server = https://dns.alidns.com/dns-query, https://doh.pub/dns-query

[Rule]

# ===== 直连 =====
# --- Bilibili B站 ---
DOMAIN-SUFFIX,bilibili.com,DIRECT
DOMAIN-SUFFIX,bilivideo.com,DIRECT
DOMAIN-SUFFIX,bilivideo.cn,DIRECT
DOMAIN-SUFFIX,hdslb.com,DIRECT
DOMAIN-SUFFIX,biliapi.net,DIRECT
DOMAIN-SUFFIX,biliapi.com,DIRECT
DOMAIN-SUFFIX,acgvideo.com,DIRECT
DOMAIN-SUFFIX,b23.tv,DIRECT

# --- 115网盘 ---
DOMAIN-SUFFIX,115.com,DIRECT
DOMAIN-SUFFIX,115cdn.com,DIRECT
DOMAIN-SUFFIX,anwang.com,DIRECT

# --- 阅文、QQ阅读与腾讯生态 ---
DOMAIN-SUFFIX,qq.com,DIRECT
DOMAIN-SUFFIX,ywdoc.com,DIRECT
DOMAIN-SUFFIX,shp.qpic.cn,DIRECT
DOMAIN-SUFFIX,qidian.com,DIRECT
DOMAIN-SUFFIX,gtimg.com,DIRECT
DOMAIN-KEYWORD,qqread,DIRECT
DOMAIN-KEYWORD,yuewen,DIRECT
DOMAIN-KEYWORD,geetest,DIRECT

# --- 百度 ---
DOMAIN-SUFFIX,baidu.com,DIRECT
DOMAIN-SUFFIX,baidupcs.com,DIRECT
DOMAIN-SUFFIX,bdimg.com,DIRECT

# --- 字节跳动 / 抖音 / 头条 ---
DOMAIN-SUFFIX,bytedance.com,DIRECT
DOMAIN-SUFFIX,snssdk.com,DIRECT
DOMAIN-SUFFIX,pstatp.com,DIRECT
DOMAIN-SUFFIX,douyin.com,DIRECT
DOMAIN-SUFFIX,amemv.com,DIRECT
DOMAIN-SUFFIX,iesdouyin.com,DIRECT
DOMAIN-SUFFIX,toutiao.com,DIRECT
DOMAIN-SUFFIX,ixigua.com,DIRECT

# --- 京东 ---
DOMAIN-SUFFIX,jd.com,DIRECT
DOMAIN-SUFFIX,360buyimg.com,DIRECT
DOMAIN-SUFFIX,jdpay.com,DIRECT

# --- 拼多多 ---
DOMAIN-SUFFIX,pinduoduo.com,DIRECT
DOMAIN-SUFFIX,yangkeduo.com,DIRECT

# --- 新浪 / 微博 / 网易 ---
DOMAIN-SUFFIX,sina.com.cn,DIRECT
DOMAIN-SUFFIX,sinaimg.cn,DIRECT
DOMAIN-SUFFIX,weibo.com,DIRECT
DOMAIN-SUFFIX,weibocdn.com,DIRECT
DOMAIN-SUFFIX,163.com,DIRECT
DOMAIN-SUFFIX,netease.com,DIRECT
DOMAIN-SUFFIX,126.net,DIRECT
DOMAIN-SUFFIX,cn,DIRECT
GEOIP,CN,DIRECT,no-resolve
FINAL,PROXY
