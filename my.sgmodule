#!name=cn直連
#!desc=国内直连域名清单 + 直连 DNS；已把会被直连规则盖掉的广告拦截规则排在前面

[General]
direct-dns-server = https://dns.alidns.com/dns-query, https://doh.pub/dns-query

[Rule]
# 局域网/私有地址（IP 优先）
RULE-SET,https://fastly.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Shadowrocket/Lan/Lan.list,DIRECT

